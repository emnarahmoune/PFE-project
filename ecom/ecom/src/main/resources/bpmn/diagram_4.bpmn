<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0">
  <bpmn:process id="LeaveRequestProcess" name="Processus Demande de Congé" isExecutable="true" camunda:historyTimeToLive="120">
    <bpmn:startEvent id="StartEvent_1" name="Demande de congé">
      <bpmn:outgoing>Flow_Start_Verifier</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_VerifierSolde" name="Vérifier solde" camunda:class="com.codeWithProject.ecom.service.workflow.VerifierSoldeDelegate">
      <bpmn:incoming>Flow_Start_Verifier</bpmn:incoming>
      <bpmn:outgoing>Flow_Verifier_GatewaySolde</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Start_Verifier" sourceRef="StartEvent_1" targetRef="Task_VerifierSolde" />
    <bpmn:sequenceFlow id="Flow_Verifier_GatewaySolde" sourceRef="Task_VerifierSolde" targetRef="Gateway_GestionSolde" />
    <bpmn:exclusiveGateway id="Gateway_GestionSolde" name="Gestion solde">
      <bpmn:incoming>Flow_Verifier_GatewaySolde</bpmn:incoming>
      <bpmn:outgoing>Flow_RefusAuto</bpmn:outgoing>
      <bpmn:outgoing>Flow_ValidationManager</bpmn:outgoing>
      <bpmn:outgoing>Flow_Urgence</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_RefusAuto" name="solde insuffisant et non urgent" sourceRef="Gateway_GestionSolde" targetRef="Task_NotifierRefusSolde">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${soldeSuffisant == false &amp;&amp; urgente == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ValidationManager" name="solde suffisant" sourceRef="Gateway_GestionSolde" targetRef="Task_ValidationManager">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${soldeSuffisant == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Urgence" name="solde insuffisant mais urgent" sourceRef="Gateway_GestionSolde" targetRef="Task_ValidationManager">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${soldeSuffisant == false &amp;&amp; urgente == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_NotifierRefusSolde" name="Notifier refus solde" camunda:class="com.codeWithProject.ecom.service.workflow.NotifierRefusDelegate">
      <bpmn:incoming>Flow_RefusAuto</bpmn:incoming>
      <bpmn:outgoing>Flow_RefusSolde_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_RefusSolde_End" sourceRef="Task_NotifierRefusSolde" targetRef="Event_Rejetee" />
    <bpmn:userTask id="Task_ValidationManager" name="Validation Manager" camunda:assignee="${managerEmail}">
      <bpmn:incoming>Flow_ValidationManager</bpmn:incoming>
      <bpmn:incoming>Flow_Urgence</bpmn:incoming>
      <bpmn:outgoing>Flow_Manager_GatewayManager</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Manager_GatewayManager" sourceRef="Task_ValidationManager" targetRef="Gateway_ManagerApprouve" />
    <bpmn:exclusiveGateway id="Gateway_ManagerApprouve" name="Manager approuve ?">
      <bpmn:incoming>Flow_Manager_GatewayManager</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerNon</bpmn:outgoing>
      <bpmn:outgoing>Flow_ManagerOui</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ManagerNon" name="non" sourceRef="Gateway_ManagerApprouve" targetRef="Task_NotifierRefusManager">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${managerApprouve == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
   <bpmn:serviceTask id="Task_NotifierRefusManager" name="Notifier refus manager" camunda:class="com.codeWithProject.ecom.service.workflow.NotifierRefusManagerDelegate">
      <bpmn:incoming>Flow_ManagerNon</bpmn:incoming>
      <bpmn:outgoing>Flow_RefusManager_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_RefusManager_End" sourceRef="Task_NotifierRefusManager" targetRef="Event_Rejetee" />
    <bpmn:sequenceFlow id="Flow_ManagerOui" name="oui" sourceRef="Gateway_ManagerApprouve" targetRef="Task_ValidationRH">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${managerApprouve == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Task_ValidationRH" name="Validation Admin RH" camunda:assignee="${adminEmail}">
      <bpmn:incoming>Flow_ManagerOui</bpmn:incoming>
      <bpmn:outgoing>Flow_RH_GatewayRH</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_RH_GatewayRH" sourceRef="Task_ValidationRH" targetRef="Gateway_RHApprouve" />
    <bpmn:exclusiveGateway id="Gateway_RHApprouve" name="RH approuve ?">
      <bpmn:incoming>Flow_RH_GatewayRH</bpmn:incoming>
      <bpmn:outgoing>Flow_RHNon</bpmn:outgoing>
      <bpmn:outgoing>Flow_RHOui</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_RHNon" name="non" sourceRef="Gateway_RHApprouve" targetRef="Task_NotifierRefusRH">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rhApprouve == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_NotifierRefusRH" name="Notifier REFUS" camunda:class="com.codeWithProject.ecom.service.workflow.NotifierRefusDelegate">
      <bpmn:incoming>Flow_RHNon</bpmn:incoming>
      <bpmn:outgoing>Flow_RefusRH_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_RefusRH_End" sourceRef="Task_NotifierRefusRH" targetRef="Event_Rejetee" />
    <bpmn:sequenceFlow id="Flow_RHOui" name="oui" sourceRef="Gateway_RHApprouve" targetRef="Task_DeduireSolde">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rhApprouve == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_DeduireSolde" name="Déduire solde" camunda:class="com.codeWithProject.ecom.service.workflow.DeduireSoldeDelegate">
      <bpmn:incoming>Flow_RHOui</bpmn:incoming>
      <bpmn:outgoing>Flow_Deduction_Notif</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotifierApprobation" name="Notifier APPROBATION" camunda:class="com.codeWithProject.ecom.service.workflow.NotifierApprouveDelegate">
      <bpmn:incoming>Flow_Deduction_Notif</bpmn:incoming>
      <bpmn:outgoing>Flow_Notif_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Deduction_Notif" sourceRef="Task_DeduireSolde" targetRef="Task_NotifierApprobation" />
    <bpmn:sequenceFlow id="Flow_Notif_End" sourceRef="Task_NotifierApprobation" targetRef="Event_Approuvee" />
    <bpmn:endEvent id="Event_Approuvee" name="Approuvée">
      <bpmn:incoming>Flow_Notif_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_Rejetee" name="Demande rejetée">
      <bpmn:incoming>Flow_RefusSolde_End</bpmn:incoming>
      <bpmn:incoming>Flow_RefusManager_End</bpmn:incoming>
      <bpmn:incoming>Flow_RefusRH_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="LeaveRequestProcess">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="220" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="206" y="84.5" width="64" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
